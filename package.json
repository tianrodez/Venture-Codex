    "high-contrast",
    "vivid",
    "colorful",
    "wcag-aaa",
    "wcag-aa",
    "venture",
    "codex",
    "vibrant",
    "coding",
    "developer",
    "programming",
    "venture-codex"
  ],
  "homepage": "https://github.com/tianrodez/venture-codex",
  "repository": {
